{
  "name": "Git & GitLab Seminar",
  "build": { "dockerfile": "../container/Dockerfile", "context": "../container" },
  "remoteUser": "seminar",
  "containerEnv": { "SEMINAR": "${containerWorkspaceFolder}" },
  "features": { "ghcr.io/devcontainers/features/docker-in-docker:2": {} },
  "customizations": { "vscode": { "extensions": ["ms-python.python", "eamodio.gitlens", "GitLab.gitlab-workflow"] } },
  "postCreateCommand": "mkdir -p ~/seminar && seminar-hilfe"
}
